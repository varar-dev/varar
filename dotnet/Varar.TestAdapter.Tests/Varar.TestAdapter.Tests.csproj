<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Varar.TestAdapter.Tests</RootNamespace>
    <!-- xUnit v3 test projects are self-contained executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 on the VSTest runner: the mtp-off variant keeps `dotnet test` on VSTest. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3.mtp-off" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- XPlat Code Coverage collector for `make coverage` (dotnet test → Cobertura). -->
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <!--
    varar.config.json in this directory is load-bearing. This project TESTS the adapter; it is
    not itself a varar project. Referencing Varar.TestAdapter makes VSTest auto-load the adapter
    for this assembly, and the workspace walk-up would otherwise reach the repo-root
    varar.config.json and reconcile a stray varar.lock.json into the repo root. An empty
    docs.include discovers no oaths, so nothing is planned and nothing is written.
  -->
  <ItemGroup>
    <ProjectReference Include="../Varar.TestAdapter/Varar.TestAdapter.csproj" />
    <ProjectReference Include="../Varar/Varar.csproj" />
  </ItemGroup>

</Project>
