# C4 component diagram (level 3) of the Varar TypeScript workspace.
# One component per published package in typescript/packages/*; private
# packages (the cucumber compat shim, the dogfood examples) and the website
# are omitted. Every arrow is a real `workspace:` dependency taken from that
# package's package.json — but dependencies already implied by a drawn path
# are omitted for readability: most packages also declare a direct dep on
# @varar/core (its types are imported directly, and pnpm's strict
# layout requires declaring everything you import), and vitest / cli
# likewise declare config (and vitest varar). See each package.json
# for the full list.
# Boundaries follow the hexagonal architecture: pure functional core,
# imperative shell (adapters), editor tooling — plus the static-analysis
# layer shared by the test-runner and editor paths.
# Green components are ported to every language — each port has a
# counterpart by role (vitest ↔ junit/kotest ↔ pytest/
# unittest); blue components exist only in TypeScript and serve all
# ports from here.

direction: down

title: "Varar — TypeScript workspace [C4 Component]" {
  near: top-center
  shape: text
  style: {
    font-size: 28
    bold: true
  }
}

classes: {
  person: {
    shape: person
    style: {
      fill: "#08427B"
      font-color: "#FFFFFF"
      stroke: "#052E56"
    }
  }
  component: {
    style: {
      fill: "#85BBF0"
      font-color: "#000000"
      stroke: "#5D82A8"
      border-radius: 4
    }
  }
  ported: {
    style: {
      fill: "#8FCE8F"
      font-color: "#000000"
      stroke: "#639B63"
      border-radius: 4
    }
  }
  external: {
    style: {
      fill: "#999999"
      font-color: "#FFFFFF"
      stroke: "#6B6B6B"
      border-radius: 4
    }
  }
  boundary: {
    style: {
      fill: "transparent"
      stroke: "#444444"
      stroke-dash: 5
      font-color: "#444444"
    }
  }
}

developer: "Oath author / developer\n[Person]\n\nWrites *.md oaths and\n*.steps.ts step definitions" {
  class: person
}

vitest: "Vitest\n[External system]\n\nTest runner" {
  class: external
}

vscode: "VS Code\n[External system]\n\nEditor" {
  class: external
}

core: "Functional core — pure functions over immutable data, no I/O" {
  class: boundary

  core: "@varar/core\n[Component: npm package]\n\nPure core: parser, matcher, planner,\nexecutor, AST, diagnostics,\nreturn-based comparison" {
    class: ported
  }

  var: "@varar/varar\n[Component: npm package]\n\nAuthoring API: steps with\nstimulus / sensor role functions" {
    class: ported
  }

  config: "@varar/config\n[Component: npm package]\n\nvarar.config.json schema and\noath-glob resolution" {
    class: ported
  }
}

analysis: "Static analysis — pure given sources and an injected grammar loader" {
  class: boundary

  language: "@varar/language\n[Component: npm package]\n\nStatic analysis: step-definition scanner,\nworkspace indexer, snippet emitter" {
    class: component
  }
}

shell: "Imperative shell — adapters, the only place side effects live" {
  class: boundary

  runner: "@varar/runner\n[Component: npm package]\n\nRunner shell: loads oath and step files,\nexecutes plans" {
    class: ported
  }

  vitest: "@varar/vitest\n[Component: npm package]\n\nVitest adapter: drives vitest's\ninclude/exclude from varar.config.json" {
    class: ported
  }

  cli: "@varar/cli\n[Component: npm package]\n\nCommand-line interface" {
    class: component
  }
}

tooling: "Editor tooling" {
  class: boundary

  lsp: "@varar/lsp\n[Component: npm package]\n\nLanguage server: diagnostics,\ngo-to-definition, completions" {
    class: component
  }

  vscode: "varar\n[Component: VS Code extension]\n\nHighlights matched steps,\nmissing-step diagnostics" {
    class: component
  }
}

legend: "Legend" {
  class: boundary

  ported: "Ported to every language\n(counterpart in java/ and python/)" {
    class: ported
  }

  tsonly: "TypeScript-only\n(serves all ports from TypeScript)" {
    class: component
  }
}

# --- People and external systems ---

developer -> core.var: authors oaths and steps with
developer -> tooling.vscode: edits oaths in

shell.vitest -> vitest: plugs into
tooling.vscode -> vscode: installs into

# --- Functional core ---

core.var -> core.core
core.config -> core.core

# --- Static analysis ---

analysis.language -> core.core

# --- Imperative shell ---

shell.runner -> core.var
shell.runner -> core.config

shell.vitest -> shell.runner
shell.vitest -> analysis.language

shell.cli -> shell.runner

# --- Editor tooling ---

tooling.lsp -> analysis.language
tooling.lsp -> core.config

tooling.vscode -> tooling.lsp
